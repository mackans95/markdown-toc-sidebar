{
  "version": "2.0.0",
  "tasks": [
    {
      // Rebuilds dist/ on every change; launch.json starts it before a debug session.
      "label": "watch",
      "type": "npm",
      "script": "watch",
      "isBackground": true,
      "group": { "kind": "build", "isDefault": true },
      "presentation": { "reveal": "never" },
      "problemMatcher": {
        "owner": "esbuild",
        "fileLocation": ["relative", "${workspaceFolder}"],
        "pattern": {
          "regexp": "^✘ (.*):(\\d+):(\\d+): (.*)$",
          "file": 1,
          "line": 2,
          "column": 3,
          "message": 4
        },
        "background": {
          "activeBegin": "^\\[watch\\] build started",
          "activeEnd": "^\\[watch\\] build finished"
        }
      }
    }
  ]
}
