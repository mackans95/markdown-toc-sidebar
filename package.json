{
  "name": "markdown-toc-sidebar",
  "displayName": "Markdown TOC Sidebar",
  "description": "Shows a table of contents sidebar inside the built-in Markdown preview.",
  "version": "0.1.0",
  "publisher": "mackans95",
  "license": "MIT",
  "icon": "images/icon.png",
  "scripts": {
    "test": "node --test test/*.test.js"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/mackans95/markdown-toc-sidebar.git"
  },
  "bugs": {
    "url": "https://github.com/mackans95/markdown-toc-sidebar/issues"
  },
  "homepage": "https://github.com/mackans95/markdown-toc-sidebar#readme",
  "engines": {
    "vscode": "^1.82.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "markdown",
    "preview",
    "toc",
    "table of contents",
    "outline",
    "sidebar",
    "headings",
    "navigation"
  ],
  "activationEvents": [],
  "main": "./src/extension.js",
  "browser": "./src/extension.js",
  "contributes": {
    "configuration": {
      "title": "Markdown TOC Sidebar",
      "properties": {
        "markdownTocSidebar.scrollBehavior": {
          "type": "string",
          "enum": [
            "smooth",
            "instant"
          ],
          "enumDescriptions": [
            "Animate the scroll to the heading.",
            "Jump straight to the heading."
          ],
          "default": "smooth",
          "markdownDescription": "How the preview scrolls when you click an entry in the table of contents. When your system is set to reduce motion, the preview always jumps instantly.",
          "order": 1
        },
        "markdownTocSidebar.position": {
          "type": "string",
          "enum": [
            "right",
            "left"
          ],
          "enumDescriptions": [
            "Show the sidebar on the right side of the preview.",
            "Show the sidebar on the left side of the preview."
          ],
          "default": "right",
          "markdownDescription": "Which side of the preview the table of contents sidebar is shown on.",
          "order": 2
        }
      }
    },
    "markdown.markdownItPlugins": true,
    "markdown.previewScripts": [
      "./media/smooth-scroll-sync.js",
      "./media/toc.js"
    ],
    "markdown.previewStyles": [
      "./media/toc.css"
    ]
  }
}
